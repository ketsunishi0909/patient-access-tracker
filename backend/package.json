{
  "name": "@pat/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "start": "tsx src/local/server.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/lambda.mjs --external:@aws-sdk/* --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "graphql": "^17.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
