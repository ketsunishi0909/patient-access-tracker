# Local development (default): talks to the local API through the Vite proxy, demo sign-in.
VITE_AUTH_MODE=local

# Deployed: fill these from `terraform output` and set VITE_AUTH_MODE=cognito.
# VITE_GRAPHQL_URL=https://xxxx.appsync-api.us-east-1.amazonaws.com/graphql
# VITE_COGNITO_DOMAIN=https://pat-tracker-xxxx.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxx
# VITE_REDIRECT_URI=https://dxxxx.cloudfront.net/
